#!/usr/bin/env bash

# You can call this script like this:
# volume [ up | down | mute ]

exp_time=2000
notification_id=99999

device="@DEFAULT_AUDIO_SINK@"

get_volume() {
	wpctl get-volume "$device" | awk '{print int($2 * 100) "%"}'
}

is_mute() {
	wpctl get-volume "$device" | grep -q '\[MUTED\]'
}

send_notification() {
	local volume
	volume="$(get_volume)"
	notify-send -r "$notification_id" "Volume: $volume" -t "$exp_time"
}

command="$1"

case "$command" in
up)
	wpctl set-volume "$device" "${2:-5}%+"
	send_notification
	;;

down)
	wpctl set-volume "$device" "${2:-5}%-"
	send_notification
	;;

mute)
	wpctl set-mute "$device" toggle

	if is_mute; then
		notify-send -r "$notification_id" "Muted" -t "$exp_time"
	else
		send_notification
	fi
	;;
esac
