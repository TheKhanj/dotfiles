#!/bin/bash
set -eu

if [ "$#" -lt 2 ]; then
	echo "Usage: sandbox DIR -- COMMAND [ARGS...]" >&2
	exit 1
fi

dir=$(realpath "$1")
shift

[ "$1" = "--" ] || {
	echo "Expected -- before command" >&2
	exit 1
}
shift

cmd="$1"

extra=()

if [ "$cmd" = "opencode" ]; then
	for d in \
		"$HOME/.local/share/opencode" \
		"$HOME/.local/state/opencode" \
		"$HOME/.cache/opencode"; do
		if [ -d "$d" ]; then
			extra+=(--dir "$d")
			extra+=(--bind "$d" "$d")
		fi
	done
fi

xauth_file=${XAUTHORITY:-"$HOME/.Xauthority"}
x11=()

if [ -n "${DISPLAY:-}" ]; then
	x11+=(--setenv DISPLAY "$DISPLAY")
	x11+=(--ro-bind-try /tmp/.X11-unix /tmp/.X11-unix)

	if [ -f "$xauth_file" ]; then
		x11+=(--setenv XAUTHORITY /tmp/.Xauthority)
		x11+=(--ro-bind "$xauth_file" /tmp/.Xauthority)
	fi
fi

exec bwrap \
	--unshare-all \
	--share-net \
	--die-with-parent \
	--new-session \
	--tmpfs "$HOME" \
	--dir "$HOME/.local" \
	--dir "$HOME/.local/share" \
	--dir "$HOME/.local/state" \
	--dir "$HOME/.cache" \
	--ro-bind /usr /usr \
	--ro-bind /bin /bin \
	--ro-bind /lib /lib \
	--ro-bind /lib64 /lib64 \
	--ro-bind /etc/resolv.conf /etc/resolv.conf \
	--ro-bind /etc/hosts /etc/hosts \
	--tmpfs /tmp \
	"${x11[@]}" \
	"${extra[@]}" \
	--proc /proc \
	--dev /dev \
	--bind "$dir" /workspace \
	--chdir /workspace \
	-- "$@"
