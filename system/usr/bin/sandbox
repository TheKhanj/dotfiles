#!/bin/bash
set -eu

if [ "$#" -lt 2 ]; then
	echo "Usage: sandbox DIR -- COMMAND [ARGS...]" >&2
	exit 1
fi

dir=$(realpath "$1")
shift

[ "$1" = "--" ] || {
	echo "Expected -- before command" >&2
	exit 1
}
shift

cmd="$1"

extra=()
if [ "$cmd" = "opencode" ]; then
	for dir in \
		"$HOME/.local/share/opencode" \
		"$HOME/.local/state/opencode" \
		"$HOME/.cache/opencode"; do
		if [ -d "$dir" ]; then
			extra+=(--bind "$dir" "$dir")
		fi
	done
fi

exec bwrap \
	--unshare-all \
	--share-net \
	--die-with-parent \
	--new-session \
	--ro-bind /usr /usr \
	--ro-bind /bin /bin \
	--ro-bind /lib /lib \
	--ro-bind /lib64 /lib64 \
	--ro-bind /etc/resolv.conf /etc/resolv.conf \
	--ro-bind /etc/hosts /etc/hosts \
	--ro-bind "$HOME" "$HOME" \
	"${extra[@]}" \
	--proc /proc \
	--dev /dev \
	--tmpfs /tmp \
	--bind "$dir" /workspace \
	--chdir /workspace \
	-- "$@"
