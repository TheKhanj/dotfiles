#!/usr/bin/env bash
set -euo pipefail

usage() {
	cat <<-EOF >&2
	Usage: lc [options] [directory]
	Count lines grouped by subdirectory/file.

	Options:
	  -j, --jobs <n>    Number of parallel jobs (default: auto)
	  -d, --depth <n>   Max traversal depth (default: 1)
	  -t, --type <a|f|d>  Filter: a=all, f=files, d=dirs (default: a)
	  -s, --sort <c|n|t>  Sort by: c=count, n=name, t=type (default: c)
	  -r, --reverse     Reverse sort order
	  -H, --human       Human-readable numbers (1.2K, 3.4M)
	  -n, --no-total    Hide total line (shown by default)
	  -b, --binary      Include binary files in count (default: skip)
	  -a, --all         Count all files, not just git-tracked (default: git only)
	  -h, --help        Show this help

	Examples:
	  lc
	  lc src
	  lc -d 2 -t d src
	  lc -s n -r
	EOF
	exit 0
}

die() {
	echo "lc: $1" >&2
	exit 1
}

list_files() {
	local f="$1"
	if [ "$git" -eq 1 ]; then
		git ls-files "$f"
	elif [ -d "$f" ]; then
		find "$f" -type f
	else
		echo "$f"
	fi
}

count() {
	local f="$1" files
	files="$(list_files "$f")"
	[ -z "$files" ] && return 1
	if [ "$binary" -eq 0 ]; then
		files=$(echo "$files" | xargs -d '\n' grep -Il . 2>/dev/null) || return 1
		[ -z "$files" ] && return 1
	fi
	echo "$files" | xargs -d '\n' cat 2>/dev/null | wc -l
}

_lc_job() {
	local t="$1" f="$2" c
	c=$(count "$f") || return 0
	printf '%s\t%d\t%s\n' "$t" "$c" "$f"
}

export -f count list_files _lc_job

parse_opts() {
	jobs=$(($(nproc)))
	depth=1
	filter=a
	sort_key=c
	reverse=0
	human=0
	show_total=1
	binary=0
	git=1

	opts=$(getopt -o j:d:t:s:rHnbah -l jobs:,depth:,type:,sort:,reverse,human,no-total,binary,all,help -n lc -- "$@") || exit 1
	eval set -- "$opts"

	while [ $# -gt 0 ]; do
		case "$1" in
			-j|--jobs)      jobs="$2";    shift 2 ;;
			-d|--depth)     depth="$2";   shift 2 ;;
			-t|--type)      filter="$2";  shift 2 ;;
			-s|--sort)      sort_key="$2"; shift 2 ;;
			-r|--reverse)   reverse=1;    shift ;;
			-H|--human)     human=1;      shift ;;
			-n|--no-total)  show_total=0; shift ;;
			-b|--binary)    binary=1;     shift ;;
			-a|--all)       git=0;        shift ;;
			-h|--help)      usage ;;
			--)             shift; break ;;
			*)              die "unknown option: $1" ;;
		esac
	done

	dir="${1:-.}"

	case "$filter" in
		a|all)   filter= ;;
		f|files) filter=f ;;
		d|dirs)  filter=d ;;
		*)       die "invalid type '$filter' (use a, f, or d)" ;;
	esac

	case "$sort_key" in
		c|count) sort_flag="-k2" ;;
		n|name)  sort_flag="-k3" ;;
		t|type)  sort_flag="-k1" ;;
		*)       die "invalid sort key '$sort_key' (use c, n, or d)" ;;
	esac
}

collect() {
	: > "$results"

	if [ "$filter" != f ]; then
		find "$dir" -maxdepth "$depth" -mindepth "$depth" -type d -print0 2>/dev/null |
			parallel -0 -j "$jobs" _lc_job d {}/ >> "$results"
	fi

	if [ "$filter" != d ]; then
		find "$dir" -maxdepth "$depth" -mindepth 1 -type f -print0 2>/dev/null |
			parallel -0 -j "$jobs" _lc_job f {} >> "$results"
	fi

	total=$(awk -F'\t' '{s+=$2} END{print s+0}' "$results")
}

display() {
	sort $sort_flag -h "$results" | {
		if [ "$reverse" -eq 1 ]; then sort -r; else cat; fi
	} | {
		if [ "$human" -eq 1 ]; then
			while IFS=$'\t' read -r t c f; do
				hc=$(numfmt --to=si "$c" 2>/dev/null || echo "$c")
				printf "%s %-6s %s\n" "$t" "$hc" "$f"
			done
		else
			while IFS=$'\t' read -r t c f; do
				printf "%s %-6s %s\n" "$t" "$c" "$f"
			done
		fi
	}

	if [ "$show_total" -eq 1 ]; then
		ht="$total"
		[ "$human" -eq 1 ] && ht=$(numfmt --to=si "$total" 2>/dev/null || echo "$total")
		printf "T %-6s total\n" "$ht"
	fi
}

main() {
	parse_opts "$@"

	export binary git

	results=$(mktemp)
	trap 'rm -f "$results"' EXIT

	collect
	display
}

main "$@"
